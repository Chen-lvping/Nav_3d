ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base

SHELL ["/bin/bash", "-c"]
ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions python3-rosdep python3-venv python3-yaml \
      ros-${ROS_DISTRO}-geometry-msgs ros-${ROS_DISTRO}-nav-msgs \
      ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-tf2-msgs && \
    python3 -m venv --system-site-packages /opt/nav3d_venv && \
    /opt/nav3d_venv/bin/pip install --no-cache-dir 'roslibpy>=1.5.0' && \
    rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/nav3d_venv/bin:${PATH}

COPY ros2_ws /opt/nav3d_ros2_ws
WORKDIR /opt/nav3d_ros2_ws
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" && colcon build --merge-install

COPY docker/entrypoint.ros2.sh /ros_entrypoint_nav3d_ros2.sh
RUN chmod +x /ros_entrypoint_nav3d_ros2.sh
ENTRYPOINT ["/ros_entrypoint_nav3d_ros2.sh"]
CMD ["ros2", "launch", "nav3d_ros2_adapter", "bridge.launch.py"]
