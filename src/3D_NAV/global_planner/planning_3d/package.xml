  <version>0.1.0</version>
  <description>Native ROS 2 PRM/A* global planner for Nav_3d.</description>
  <maintainer email="user@example.com">Nav_3d maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav3d_ros2_compat</depend>
  <depend>pcl_conversions</depend>
